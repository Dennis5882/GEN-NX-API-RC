{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "tests/**",
      "*.json",
      "*.ts",
      "*.html",
      "!!archive",
      "!!dist",
      "!!shared",
      "!!src/i18n/keys.gen.ts",
      "!!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "includes": [
      "biome.json",
      "package.json",
      "vitest.config.ts",
      "tests/setup.mjs",
      "tests/_assertions.mjs",
      "components.json",
      "src/lib/utils.ts",
      "src/styles/*.css",
      "src/components/ui/**",
      "src/styles/component-classes.ts",
      "src/styles/html-classes.json",
      "tests/ui-migration.test.tsx",
      "playwright.config.ts",
      "tests/browser/**",
      "tests/engine.golden.test.mjs",
      "src/engine/**",
      "tests/engine-domains.golden.test.mjs",
      "tests/engine-pure.test.mjs",
      "src/i18n/**",
      "tests/i18n.test.mjs",
      "scripts/i18n-check.mjs"
    ],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded"
    }
  },
  "assist": {
    "includes": [
      "vitest.config.ts",
      "tests/setup.mjs",
      "tests/_assertions.mjs",
      "src/lib/utils.ts"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "tailwind": {
    "stylesheet": "./src/styles/globals.css"
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useTailwindSortedClasses": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "scripts/**", "*.html"],
      "linter": {
        "rules": {
          "a11y": {
            "noAutofocus": "warn",
            "noLabelWithoutControl": "warn",
            "noStaticElementInteractions": "warn",
            "useButtonType": "warn",
            "useHeadingContent": "warn",
            "useKeyWithClickEvents": "warn",
            "useSemanticElements": "warn"
          },
          "correctness": {
            "noComponentHookFactories": "warn",
            "noInnerDeclarations": "warn",
            "useExhaustiveDependencies": "warn",
            "useHookAtTopLevel": "warn"
          },
          "security": {
            "noDangerouslySetInnerHtml": "warn"
          },
          "suspicious": {
            "noArrayIndexKey": "warn",
            "noAssignInExpressions": "warn",
            "noImplicitAnyLet": "warn",
            "useIterableCallbackReturn": "warn"
          }
        }
      }
    }
  ]
}
