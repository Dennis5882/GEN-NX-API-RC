{
  "name": "gen-nx-rc-agent",
  "private": true,
  "version": "3.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "i18n:check": "node scripts/i18n-check.mjs",
    "build": "node scripts/i18n-check.mjs && node scripts/release-check.mjs && tsc -b && vite build",
    "typecheck": "node scripts/i18n-check.mjs && node scripts/release-check.mjs && tsc -b",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "test:watch": "vitest",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "midas-nx": "^2.11.1",
    "plotly.js-dist-min": "^2.35.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.5",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
