{
  "name": "gen-nx-rc-agent",
  "private": true,
  "version": "3.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "i18n:check": "node scripts/i18n-check.mjs",
    "build": "node scripts/i18n-check.mjs && node scripts/release-check.mjs && tsc -b && vite build",
    "typecheck": "node scripts/i18n-check.mjs && node scripts/release-check.mjs && tsc -b",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "test:watch": "vitest",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "dependencies": {
    "midas-nx": "^2.10.2",
    "plotly.js-dist-min": "^2.35.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.5",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
